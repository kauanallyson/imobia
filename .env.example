DATABASE_URL=postgresql://imobia:imobia@localhost:5432/imobia

# bunx auth secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console → OAuth client (web). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta app → WhatsApp → Configuration (webhook). Pick any random string; paste the same in Meta.
WHATSAPP_VERIFY_TOKEN=
# Meta app → App settings → Basic → App secret
WHATSAPP_APP_SECRET=
