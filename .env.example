DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# URL pública do app; a Evolution chama APP_URL/api/webhooks/evolution
APP_URL=http://localhost:3000

# Evolution API (ADR-0004)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# Gere com: openssl rand -hex 24
EVOLUTION_WEBHOOK_SECRET=

# Cloudflare R2 (S3Client nativo do Bun). R2_ENDPOINT ou R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loteai

# Testes: por padrão `bun test` sobe o container Podman crm-postgres-test (porta 5433).
# Defina para usar outro Postgres com pgvector.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/crm_test
