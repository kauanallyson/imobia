# Copie para `.env`. O mesmo arquivo serve ao `bun run dev` (fora dos
# containers) e ao `podman compose` (dentro). Passo a passo: docs/deploy.md.

# --- Postgres (serviço `postgres` do compose) -------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm
# Porta exposta no loopback do host (dev). No VPS pode ficar como está.
POSTGRES_PORT=5432

# URL usada fora dos containers (dev, scripts como admin:create).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
# Dentro do compose o app/worker/migrate montam a URL com o host `postgres`
# a partir de POSTGRES_*; só defina para usar um banco externo.
# DATABASE_URL_COMPOSE=postgresql://user:senha@host:5432/crm

# --- App ---------------------------------------------------------------------
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do app (dev: http://localhost:3000; VPS: https://crm.exemplo.com.br).
BETTER_AUTH_URL=http://localhost:3000
# A Evolution chama APP_URL/api/webhooks/evolution; precisa ser alcançável
# pelo container da Evolution (no VPS, a URL pública; nunca localhost).
APP_URL=http://localhost:3000
# Porta publicada pelo serviço `app` (padrão só no loopback; com o Caddy
# não precisa expor). Ex.: APP_PORT=3000 publica em todas as interfaces.
# APP_PORT=127.0.0.1:3000

# --- Evolution API (ADR-0004) -----------------------------------------------
# Fora dos containers (dev). Dentro do compose o app usa http://evolution:8080.
EVOLUTION_API_URL=http://localhost:8080
# Gere com: openssl rand -hex 32  (é a AUTHENTICATION_API_KEY da Evolution)
EVOLUTION_API_KEY=
# Gere com: openssl rand -hex 24  (header x-webhook-secret dos webhooks)
EVOLUTION_WEBHOOK_SECRET=
# Nome da instância (chip próprio) que manda os avisos de pendência aos
# corretores. Crie-a na Evolution e pareie o celular; sem ela nenhum aviso sai.
EVOLUTION_SYSTEM_INSTANCE=loteai-sistema
# Porta publicada pela Evolution (padrão só no loopback do VPS; acesse por
# túnel SSH se precisar do manager). Ela não precisa ser pública.
# EVOLUTION_PORT=127.0.0.1:8080
# URL que a Evolution anuncia em respostas (só informativa).
# EVOLUTION_PUBLIC_URL=http://localhost:8080
# EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO

# --- OpenAI (embeddings da base de conhecimento, assistente, transcrição) ---
OPENAI_API_KEY=

# --- Reverse proxy opcional (profile `proxy`, Caddy com HTTPS automático) ---
# APP_DOMAIN=crm.exemplo.com.br
# CADDY_EMAIL=voce@exemplo.com.br

# --- Cloudflare R2 (storage; src/lib/storage.ts, S3Client nativo do Bun) ---
# Obrigatórias. Informe R2_ENDPOINT ou R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loteai
# R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Testes -----------------------------------------------------------------
# Por padrão `bun test` sobe o container Podman crm-postgres-test (porta 5433).
# Defina para usar outro Postgres com pgvector.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/crm_test
