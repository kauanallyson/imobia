{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/db",
                      "@/db/**",
                      "@/adapters/**",
                      "@/server/**",
                      "@/app/**",
                      "@/worker/**",
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "pg"
                    ],
                    "message": "ADR-0005: o dom\u00ednio s\u00f3 importa a si mesmo; dependa de uma porta em src/domain/ports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/db/**", "src/adapters/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/server/**",
                      "@/app/**",
                      "@/worker/**",
                      "next",
                      "next/**"
                    ],
                    "message": "ADR-0005: implementa\u00e7\u00f5es de portas n\u00e3o conhecem Next.js nem a raiz de composi\u00e7\u00e3o."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/db", "@/db/**", "@/adapters/**"],
                    "message": "ADR-0005: a camada Next.js chega ao dom\u00ednio por src/server (getDomain)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
